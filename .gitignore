bin/
obj/
.vs/
*.user
*.suo
appsettings.*.local.json

# Video is ignored by default so a stray clip cannot land in history by
# accident, then the two the site actually needs are re-admitted by name.
# Both are served straight out of wwwroot on the deployed container, so they
# have to be in the repo — see "Deploying to Render" in README.md.
wwwroot/video/*.mp4
wwwroot/video/*.webm
!wwwroot/video/elite-industries-intro.mp4
!wwwroot/video/hero.mp4
