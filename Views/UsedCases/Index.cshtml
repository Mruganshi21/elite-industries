@model IReadOnlyList<EliteIndustries.Models.Industry>
@using EliteIndustries.Models
@using EliteIndustries.Services
@*
    Used Cases — the sectors the company supplies.

    WHAT THIS REPLACED
    ------------------
    Three long written-up case studies: a tier-one automotive supplier shipping
    castings Nhava Sheva to Bremerhaven, a 340-container programme with a
    cost-per-container figure, a supplier caught sub-contracting an ISPM-15
    heat treatment. All of it invented, none of it from the client, and the
    page said in as many words that "figures come from the consignment records
    we keep" — which turned fiction into a claim about our own records.

    The client's own Used Cases section is seventeen sectors, each listing the
    products that serve it. That is what this page is now. Every pairing comes
    from IndustryCatalog, which was transcribed from those pages; see the
    remarks on that class for the two places where the client's product naming
    is finer-grained than this catalogue.

    A sector here is a heading and a product list, not a link: the client's
    seventeen sector pages have no prose of their own to justify a page each,
    and seventeen stubs would be worse than one honest listing. If the client
    supplies sector copy, this is the point to grow detail pages from — the
    slugs are already on the model and already unique.
*@
@{
    ViewData["Title"] = "Used Cases";
    ViewData["ActiveNav"] = "usedcases";
    // TEMPORARY — this page still renders against site.css. See _Layout.
    ViewData["Legacy"] = true;
    ViewData["SeoTitle"] = $"Export Packaging by Industry | {CompanyProfile.Name}";
    ViewData["Description"] = $"The industries {CompanyProfile.Name} supplies — from agriculture, ports and textiles to solar, pharmaceuticals and HVAC — and the export packaging and material handling products each one is served by.";
}

<section class="page-header">
    <div class="shell">
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li aria-current="page">Used Cases</li>
        </ol>
        <h1>Used Cases</h1>
        <p>
            The sectors we supply, and what each one is packed with.
        </p>
    </div>
</section>

<section class="section-sm">
    <div class="shell">
        <div class="section-head center">
            <span class="eyebrow center-line">Industries served</span>
            <h2>@Model.Count industries, @ProductCatalog.ForNav.Count product lines</h2>
            <p>
                Export packaging is our key USP, and the requirement changes with the
                cargo — a pallet of tiles, a crate of solar modules and a drum of
                chemicals are three different load problems. Every product listed
                against a sector below is one we supply into it.
            </p>
        </div>
    </div>
</section>

<section class="section" style="padding-top:0">
    <div class="shell">

        @*  One card per sector. The card is not a link — see the note at the
            top of this file — so the products inside it are the links, and they
            go to the detail page that already exists for each.  *@
        <div class="grid cols-3 reveal">
            @foreach (var industry in Model)
            {
                var products = IndustryCatalog.ProductsFor(industry);

                <div class="info-card" id="@industry.Slug">
                    <h3>
                        @industry.Name
                        @if (industry.Expansion is not null)
                        {
                            @* Spelled out because the client spells it out, and
                               because HVAC alone is not obvious to everyone. *@
                            <span class="muted">(@industry.Expansion)</span>
                        }
                    </h3>

                    @if (products.Count > 0)
                    {
                        <ul class="check-list">
                            @foreach (var product in products)
                            {
                                <li>
                                    <a asp-controller="Products" asp-action="Detail" asp-route-slug="@product.Slug">@product.Name</a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="shell">
        <div class="cta-inner reveal">
            <div>
                <h2>Not sure which applies?</h2>
                <p>
                    Tell us what is being shipped, how much of it and when it has to leave, and
                    we will quote the material for the job — any quantity, urgent or large.
                </p>
            </div>
            <div class="cta-actions">
                <a class="btn btn-light btn-lg" href="tel:@CompanyProfile.PhonePrimaryHref">
                    <svg width="18" height="18" aria-hidden="true"><use href="#i-phone" /></svg>
                    @CompanyProfile.PhonePrimary
                </a>
                <a class="btn btn-ghost-light btn-lg" asp-controller="Contact" asp-action="Index">
                    Contact Us
                    <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
            </div>
        </div>
    </div>
</section>
