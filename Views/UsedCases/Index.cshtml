@model IReadOnlyList<EliteIndustries.Models.Industry>
@using EliteIndustries.Models
@using EliteIndustries.Services
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@*
    Use Cases — a photo wall, one tile per industry.

    The client asked for photographs only: no description, no product lists.
    Each tile carries the industry's photo and its name, nothing else. The
    name stays because a wall of unlabelled pictures cannot be told apart, and
    because other pages deep-link here by industry (UsedCases#slug from the
    About page and every product page) — the id is on the tile.

    Rebuilt onto theme.css: no ViewData["Legacy"]. Styles are
    wwwroot/css/usecases-page.css (.ei-uc-*); the 3D tilt and the photo viewer
    are wwwroot/js/usecases-page.js.

    PHOTOS
    ------
    wwwroot/img/usecases/{slug}.jpg (or .jpeg / .webp / .png). The view checks
    the disk, so a photo shows up as soon as the file is dropped in, with no
    code change; until then the tile renders a coloured placeholder with the
    industry's initials. See wwwroot/img/usecases/README.md for the file names.

    With no photo a tile is not a button — there is nothing to enlarge.
*@
@{
    ViewData["Title"] = "Use Cases";
    ViewData["ActiveNav"] = "usedcases";
    ViewData["SeoTitle"] = $"Export Packaging by Industry | {CompanyProfile.Name}";
    ViewData["Description"] = $"The {Model.Count} industries {CompanyProfile.Name} supplies with export packaging and material handling products — from agriculture, ports and textiles to solar, healthcare and HVAC.";

    string? PhotoFor(string slug)
    {
        foreach (var ext in new[] { ".jpg", ".jpeg", ".webp", ".png" })
        {
            var relative = $"img/usecases/{slug}{ext}";
            if (System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, relative)))
            {
                return "/" + relative;
            }
        }
        return null;
    }

    string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(w => w != "and" && w != "&")
            .Take(2)
            .Select(w => char.ToUpperInvariant(w[0])));
}

@section Head {
    <link rel="stylesheet" href="~/css/usecases-page.css" asp-append-version="true" />
}

<section class="ei-uc-hero" aria-labelledby="ei-uc-title">
    <div class="ei-shell">
        <ol class="ei-uc-crumbs">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li aria-current="page">Use Cases</li>
        </ol>
        <h1 class="ei-uc-title" id="ei-uc-title">Use <span>Cases</span></h1>
    </div>
</section>

<section class="ei-uc-wall" aria-labelledby="ei-uc-title">
    <div class="ei-shell">
        <ul class="ei-uc-grid" data-uc-grid>
            @for (var i = 0; i < Model.Count; i++)
            {
                var industry = Model[i];
                var photo = PhotoFor(industry.Slug);
                var label = industry.Expansion is null ? industry.Name : $"{industry.Name} ({industry.Expansion})";

                <li class="ei-uc-cell ei-reveal" id="@industry.Slug" style="--d:@(Math.Min(i, 8) * 60)ms">
                    @if (photo is not null)
                    {
                        <button class="ei-uc-tile" type="button" data-uc-tilt
                                data-uc-src="@Url.Content("~" + photo)" data-uc-name="@label"
                                aria-label="View photo: @label">
                            <span class="ei-uc-media">
                                <img src="@Url.Content("~" + photo)" alt="" loading="lazy" decoding="async" />
                            </span>
                            <span class="ei-uc-glare" aria-hidden="true"></span>
                            <span class="ei-uc-name">@industry.Name</span>
                        </button>
                    }
                    else
                    {
                        <div class="ei-uc-tile ei-uc-tile--empty" data-uc-tilt>
                            <span class="ei-uc-media" aria-hidden="true">
                                <span class="ei-uc-initials">@Initials(industry.Name)</span>
                            </span>
                            <span class="ei-uc-glare" aria-hidden="true"></span>
                            <span class="ei-uc-name">@industry.Name</span>
                        </div>
                    }
                </li>
            }
        </ul>
    </div>
</section>

@* Photo viewer. A native <dialog>: Esc closes it and focus returns to the
   tile that opened it. *@
<dialog class="ei-uc-viewer" data-uc-viewer aria-labelledby="ei-uc-viewer-name">
    <figure class="ei-uc-viewer-figure">
        <img data-uc-viewer-img alt="" />
        <figcaption id="ei-uc-viewer-name" data-uc-viewer-name></figcaption>
    </figure>
    <form method="dialog">
        <button class="ei-uc-viewer-close" type="submit" aria-label="Close photo">
            <svg aria-hidden="true"><use href="#i-close" /></svg>
        </button>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/usecases-page.js" asp-append-version="true" defer></script>
}
