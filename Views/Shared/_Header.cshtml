@using EliteIndustries.Models
@using EliteIndustries.Services
@*
    Masthead.

    A warm gradient contact strip over one row: brand left, the five signed-off
    tabs and the brochure button right, closed along the bottom by the strap —
    a red-to-amber band with a slow run of light along it. The current tab is
    marked by a gradient underline under its label (shell.css), no script.
    The address block and the language picker that used to live up here are
    gone — the client dropped the language switcher and the search overlay, and
    the address belongs in the footer. The top of the page is navigation only.

    Two of the five tabs carry a dropdown. Both are <button aria-expanded>
    rather than a link that also opens something: a control whose entire job is
    to reveal a panel is a button, and making it an anchor would promise a
    destination that the About and Products *sections* do have but that this
    control does not go to. The panel's own first row is the section landing
    page where one exists.
*@
@{
    // Accepts: home, about, products, usecases, contact. Anything else — and
    // the deliberate empty string on Privacy, Error and the footer-only stubs —
    // highlights nothing. "usedcases" is taken as well because that is the
    // controller name, and the interior views spell it that way today.
    var nav = ViewData["ActiveNav"] as string ?? "";
    var onUseCases = nav is "usecases" or "usedcases";

    // AboutController.Index renders overview / ideology / achievements as three
    // tab panels on one page, so these are fragments rather than routes.
    var aboutSections = new[]
    {
        ("overview",     "Overview"),
        ("ideology",     "Ideology"),
        ("achievements", "Achievements")
    };
}

<header class="ei-hd" id="siteHeader" data-hd>

    @*  The contact strip. A warm gradient band above the bar carrying the
        things a buyer looks for before they look at the menu: the address to
        write to, the number to ring, the hours, and the social pages. It is
        what folds away once the page scrolls (shell.css), and it is not
        rendered visible below 1000px — the call button and the slide-in
        panel carry the same details there. *@
    <div class="ei-hd-top">
        <div class="ei-shell ei-hd-top-inner">
            <ul class="ei-hd-top-info">
                <li>
                    <a class="ei-hd-top-item" href="mailto:@CompanyProfile.Email">
                        <span class="ei-hd-chip"><svg aria-hidden="true"><use href="#i-mail" /></svg></span>
                        @CompanyProfile.Email
                    </a>
                </li>
                <li>
                    <a class="ei-hd-top-item" href="tel:@CompanyProfile.PhonePrimaryHref">
                        <span class="ei-hd-chip"><svg aria-hidden="true"><use href="#i-phone" /></svg></span>
                        <span class="ei-hd-top-label">@CompanyProfile.PhoneLabel</span>
                        <strong>@CompanyProfile.PhonePrimary</strong>
                    </a>
                </li>
                <li class="ei-hd-top-hours">
                    <span class="ei-hd-top-item">
                        <span class="ei-hd-chip"><svg aria-hidden="true"><use href="#i-clock" /></svg></span>
                        @CompanyProfile.BusinessHours
                    </span>
                </li>
            </ul>

            <div class="ei-hd-top-end">
                <span class="ei-hd-top-badge">
                    <svg aria-hidden="true"><use href="#i-award" /></svg>
                    Trusted since @CompanyProfile.FoundedYear
                </span>
                <ul class="ei-hd-top-social">
                    <li><a href="@CompanyProfile.LinkedIn" target="_blank" rel="noopener" aria-label="@CompanyProfile.Name on LinkedIn"><svg aria-hidden="true"><use href="#i-linkedin" /></svg></a></li>
                    <li><a href="@CompanyProfile.Facebook" target="_blank" rel="noopener" aria-label="@CompanyProfile.Name on Facebook"><svg aria-hidden="true"><use href="#i-facebook" /></svg></a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="ei-shell ei-hd-inner">

        @*  The client's logo. It replaces a drawn crate mark plus the
            company name set in type — that pair was a stand-in, and the two
            together said the name twice anyway.

            width/height are the file's intrinsic pixels, so the box is
            reserved before the image arrives and the masthead does not jolt
            on load. The alt text is the company name, and the link's own
            aria-label went with the change: an <img> alt inside an <a>
            already names the link, and carrying both made a screen reader
            announce the name twice.

            NOT lazy-loaded and NOT async-decoded. It is the first thing in
            the document and above the fold on every page, so either would
            only hold it up.  *@
        <a class="ei-hd-brand" asp-controller="Home" asp-action="Index">
            <img class="ei-hd-logo"
                 src="~/img/logo.png"
                 asp-append-version="true"
                 width="301" height="132"
                 alt="@CompanyProfile.Name" />
        </a>

        <nav class="ei-hd-nav" id="ei-hd-nav" aria-label="Main" data-hd-nav>
            <ul class="ei-hd-tabs">

                <li class="ei-hd-tab">
                    <a class="ei-hd-link@(nav == "home" ? " is-current" : "")"
                       asp-controller="Home" asp-action="Index"
                       data-hd-tab
                       aria-current="@(nav == "home" ? "page" : null)">Home</a>
                </li>

                <li class="ei-hd-tab">
                    <button class="ei-hd-link@(nav == "about" ? " is-current" : "")"
                            type="button"
                            data-hd-tab data-hd-trigger
                            aria-haspopup="true" aria-expanded="false" aria-controls="ei-hd-panel-about">
                        About Us
                        <svg class="ei-hd-caret" aria-hidden="true"><use href="#i-chevron-down" /></svg>
                    </button>

                    <div class="ei-hd-panel" id="ei-hd-panel-about">
                        <div class="ei-hd-panel-inner">
                            <ul class="ei-hd-panel-list">
                                @foreach (var (fragment, label) in aboutSections)
                                {
                                    <li>
                                        <a class="ei-hd-panel-link"
                                           asp-controller="About" asp-action="Index" asp-fragment="@fragment">@label</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </li>

                <li class="ei-hd-tab">
                    <button class="ei-hd-link@(nav == "products" ? " is-current" : "")"
                            type="button"
                            data-hd-tab data-hd-trigger
                            aria-haspopup="true" aria-expanded="false" aria-controls="ei-hd-panel-products">
                        Products
                        <svg class="ei-hd-caret" aria-hidden="true"><use href="#i-chevron-down" /></svg>
                    </button>

                    @* Ten products. One column runs past the fold on a laptop,
                       so the panel is two columns on desktop and one in the
                       mobile accordion — see .ei-hd-panel--wide in shell.css. *@
                    <div class="ei-hd-panel ei-hd-panel--wide" id="ei-hd-panel-products">
                        <div class="ei-hd-panel-inner">
                            <ul class="ei-hd-panel-list">
                                @foreach (var product in ProductCatalog.ForNav)
                                {
                                    <li>
                                        <a class="ei-hd-panel-link"
                                           asp-controller="Products" asp-action="Detail" asp-route-slug="@product.Slug">@product.Name</a>
                                    </li>
                                }
                                <li class="ei-hd-panel-all">
                                    <a class="ei-hd-panel-link" asp-controller="Products" asp-action="Index">View all products</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </li>

                <li class="ei-hd-tab">
                    <a class="ei-hd-link@(onUseCases ? " is-current" : "")"
                       asp-controller="UsedCases" asp-action="Index"
                       data-hd-tab
                       aria-current="@(onUseCases ? "page" : null)">Use Cases</a>
                </li>

                <li class="ei-hd-tab">
                    <a class="ei-hd-link@(nav == "contact" ? " is-current" : "")"
                       asp-controller="Contact" asp-action="Index"
                       data-hd-tab
                       aria-current="@(nav == "contact" ? "page" : null)">Contact Us</a>
                </li>
            </ul>

            @* Repeated inside the slide-in panel because the utility cluster is
               hidden below 1000px — without this the phone number would be
               unreachable on a phone, which is where it is most likely used. *@
            <div class="ei-hd-nav-tail">
                <a class="ei-hd-phone" href="tel:@CompanyProfile.PhonePrimaryHref">
                    <svg aria-hidden="true"><use href="#i-phone" /></svg>
                    @CompanyProfile.PhonePrimary
                </a>
                <a class="ei-hd-mail" href="mailto:@CompanyProfile.Email">
                    <svg aria-hidden="true"><use href="#i-mail" /></svg>
                    @CompanyProfile.Email
                </a>
                <a class="ei-hd-cta" href="@CompanyProfile.BrochurePath" download>
                    <svg aria-hidden="true"><use href="#i-download" /></svg>
                    Download Brochure
                </a>
            </div>
        </nav>

        <div class="ei-hd-utils">
            @* The number moved up into the contact strip; the bar's right-hand
               slot is the brochure, the one thing on eliteind.in's masthead
               that is an action rather than a destination. The short label
               takes over when the tab row is tight for room. *@
            <a class="ei-hd-cta" href="@CompanyProfile.BrochurePath" download>
                <span class="ei-hd-cta-icon"><svg aria-hidden="true"><use href="#i-download" /></svg></span>
                <span class="ei-hd-cta-long">Download Brochure</span>
                <span class="ei-hd-cta-short">Brochure</span>
            </a>

            @* The phone bar's one-tap call. Below 1000px the number above is
               hidden for room, and a buyer on a phone should not have to open
               the menu to ring the works. The accessible name carries the
               number, since the button itself shows only the glyph. *@
            <a class="ei-hd-call" href="tel:@CompanyProfile.PhonePrimaryHref"
               aria-label="Call @CompanyProfile.PhonePrimary">
                <svg aria-hidden="true"><use href="#i-phone" /></svg>
            </a>

            @* The label, not just the state, flips on open — a screen reader
               announcing "Open menu, expanded" is a contradiction. *@
            <button class="ei-hd-burger" type="button"
                    data-hd-burger
                    aria-label="Open menu" aria-expanded="false" aria-controls="ei-hd-nav">
                <svg class="ei-hd-burger-open" aria-hidden="true"><use href="#i-menu" /></svg>
                <svg class="ei-hd-burger-close" aria-hidden="true"><use href="#i-close" /></svg>
            </button>
        </div>
    </div>

    @* Inside the header so it inherits the sticky stacking context: the scrim
       must dim the page without ever covering the bar that closes it. *@
    <div class="ei-hd-scrim" data-hd-scrim></div>
</header>
