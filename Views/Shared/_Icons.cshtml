    </symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.6" /><path d="M12 7.2V12l3.2 2" /></symbol>

    @* ---- action --------------------------------------------------------- *@
    <symbol id="i-download" viewBox="0 0 24 24">
        <path d="M12 3.5v11m-4.5-4.5L12 14.5 16.5 10M4.5 16.5v2.3a1.7 1.7 0 0 0 1.7 1.7h11.6a1.7 1.7 0 0 0 1.7-1.7v-2.3" />
    </symbol>
    <symbol id="i-play" viewBox="0 0 24 24"><path d="M8 5.4 19 12 8 18.6V5.4Z" /></symbol>

    @* ---- the trade ------------------------------------------------------
       The stat and value icons. These are drawn from the subject rather than
       picked from a generic set: a container, a strapped pallet, a crate and
       a works building. *@
    <symbol id="i-container" viewBox="0 0 24 24">
