@*
    Inline SVG sprite for the rebuilt site.

    Referenced with:  <svg class="..."><use href="#i-phone" /></svg>

    Every symbol is drawn on a 24x24 grid as a 1.7-weight stroke with round
    caps and no fill, so an icon inherits colour from `currentColor` and sits
    at the same optical weight as its neighbours whatever size it is used at.
    Keep new symbols to that grid and that stroke weight, or the set stops
    reading as one family.

    The brand symbols at the bottom are the exception: those are filled paths,
    because a stroked social glyph does not survive at 18px.

    Rendered once, first in <body>. `display:none` on the host <svg> keeps it
    out of layout while leaving the symbols referable.
*@
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true" focusable="false">
    <defs>
        <style>
            symbol { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
            symbol.is-filled { fill: currentColor; stroke: none; }
        </style>
    </defs>

    @* ---- direction ---------------------------------------------------- *@
    <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
    <symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></symbol>
    <symbol id="i-arrow-right" viewBox="0 0 24 24"><path d="M4 12h15m-6-7 7 7-7 7" /></symbol>
    <symbol id="i-arrow-down" viewBox="0 0 24 24"><path d="M12 4v15m-7-6 7 7 7-7" /></symbol>
    <symbol id="i-arrow-up" viewBox="0 0 24 24"><path d="M12 20V5m-7 6 7-7 7 7" /></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>

    @* ---- contact -------------------------------------------------------- *@
    <symbol id="i-phone" viewBox="0 0 24 24">
        <path d="M21 16.9v2.6a1.7 1.7 0 0 1-1.9 1.7 17 17 0 0 1-7.4-2.6 16.7 16.7 0 0 1-5.1-5.1A17 17 0 0 1 4 6.1 1.7 1.7 0 0 1 5.7 4.2h2.6a1.7 1.7 0 0 1 1.7 1.5c.1.8.3 1.7.6 2.5a1.7 1.7 0 0 1-.4 1.8l-1.1 1.1a13.7 13.7 0 0 0 5.1 5.1l1.1-1.1a1.7 1.7 0 0 1 1.8-.4c.8.3 1.6.5 2.5.6a1.7 1.7 0 0 1 1.4 1.6Z" />
    </symbol>
    <symbol id="i-mail" viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="14" rx="1.6" /><path d="m3.5 6.5 8.5 6 8.5-6" />
    </symbol>
    <symbol id="i-pin" viewBox="0 0 24 24">
