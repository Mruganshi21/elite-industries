@using EliteIndustries.Models
@using EliteIndustries.Services
@*
    Footer.

    Identity, contact, the link columns, the brochure and the legal bar, on the
    dark ground — opened by a warm gradient call-to-action card and a moving
    red-to-amber strap, the same colours the masthead and the homepage cards
    use.

    Gone, because the pages behind them no longer exist in the signed-off IA:
    Our Brands, Events, News, Industries, and the whole Media column with them.
    "Solutions" was only ever a second name for the Used Cases page and is now
    labelled Use Cases, matching the header tab.

    Everything on the ink ground is white or an alpha white. --ei-steel and
    --ei-steel-soft are legible on the shell and are not legible here; the
    colour notes in shell.css say which value is doing what.
*@

<footer class="ei-ft">

    @*  The call-to-action card. A gradient panel at the head of the footer
        with the two things a buyer who has scrolled this far is ready to do:
        ring the works, or take the brochure away. *@
    <div class="ei-shell">
        <div class="ei-ft-cta">
            <div class="ei-ft-cta-copy">
                <p class="ei-ft-cta-eyebrow">Ready to ship?</p>
                <h2 class="ei-ft-cta-title">Let's pack your next consignment.</h2>
            </div>
            <div class="ei-ft-cta-actions">
                <a class="ei-ft-cta-btn ei-ft-cta-btn--solid" href="tel:@CompanyProfile.PhonePrimaryHref">
                    <svg aria-hidden="true"><use href="#i-phone" /></svg>
                    @CompanyProfile.PhonePrimary
                </a>
                <a class="ei-ft-cta-btn" href="@CompanyProfile.BrochurePath" download>
                    <svg aria-hidden="true"><use href="#i-download" /></svg>
                    Download Brochure
                </a>
            </div>
        </div>
    </div>

    <div class="ei-shell ei-ft-top">

        <div class="ei-ft-brand">
            @*  The reversed logo, because this ground is --ei-ink and the
                type in the delivered file is near-black. Only the neutral ink
                is knocked out to white; the diamond keeps the brand red. See
                the note in wwwroot/img/README.md — this variant is ours, not
                the client's, and an official reversed file supersedes it.  *@
            <a class="ei-ft-lockup" asp-controller="Home" asp-action="Index">
                <img class="ei-ft-logo"
                     src="~/img/logo-light.png"
                     asp-append-version="true"
                     width="301" height="132"
                     loading="lazy" decoding="async"
                     alt="@CompanyProfile.Name" />
            </a>

            <p class="ei-ft-tagline">
                @CompanyProfile.Tagline — manufactured and supplied from
                @CompanyProfile.City since @CompanyProfile.FoundedYear.
            </p>

            @*  Contact, as a list of icon rows. Each icon sits in a disc of its
                own warm colour (see .ei-ft-contact in shell.css).

                Two addresses, as on the client's own footer. The works is
                first and is the one the schema.org markup carries; the office
                is second and deliberately not repeated into that payload —
                see the note on CompanyProfile.OfficeStreetAddress. *@
            <ul class="ei-ft-contact">
                <li>
                    <span class="ei-ft-disc" aria-hidden="true"><svg><use href="#i-pin" /></svg></span>
                    <address class="ei-ft-address">
                        <span class="ei-ft-address-label">Works</span>
                        @CompanyProfile.StreetAddress,
                        @CompanyProfile.City, @CompanyProfile.Region @CompanyProfile.PostalCode, @CompanyProfile.Country
                    </address>
                </li>
                <li>
                    <span class="ei-ft-disc" aria-hidden="true"><svg><use href="#i-works" /></svg></span>
                    <address class="ei-ft-address">
                        <span class="ei-ft-address-label">@CompanyProfile.OfficeLabel</span>
                        @CompanyProfile.OfficeStreetAddress, @CompanyProfile.OfficeCity, @CompanyProfile.OfficeRegion
                    </address>
                </li>
                <li>
                    <span class="ei-ft-disc" aria-hidden="true"><svg><use href="#i-phone" /></svg></span>
                    @* Both numbers are dialable. On a phone that is the
                       difference between an enquiry and a copy-paste. *@
                    <p class="ei-ft-lines">
                        <a href="tel:@CompanyProfile.PhonePrimaryHref">@CompanyProfile.PhonePrimary</a>
                        <span class="ei-ft-sep" aria-hidden="true">/</span>
                        <a href="tel:@CompanyProfile.PhoneSecondaryHref">@CompanyProfile.PhoneSecondary</a>
                    </p>
                </li>
                <li>
                    <span class="ei-ft-disc" aria-hidden="true"><svg><use href="#i-mail" /></svg></span>
                    <p class="ei-ft-mail"><a href="mailto:@CompanyProfile.Email">@CompanyProfile.Email</a></p>
                </li>
            </ul>
        </div>

        <nav class="ei-ft-nav" aria-label="Footer">

            <div class="ei-ft-col">
                <h2 class="ei-ft-heading">Company</h2>
                <ul class="ei-ft-list">
                    <li><a asp-controller="About" asp-action="Index">About Us</a></li>
                    <li><a asp-controller="UsedCases" asp-action="Index">Use Cases</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">Contact Us</a></li>
                    <li><a asp-controller="Pages" asp-action="Stub" asp-route-slug="careers">Careers</a></li>
                    <li><a asp-controller="Pages" asp-action="Stub" asp-route-slug="locations">Locations</a></li>
                </ul>
            </div>

            <div class="ei-ft-col">
                <h2 class="ei-ft-heading">Products</h2>
                @* The five featured lines, not the first five in the catalogue —
                   the footer is a shortcut to what sells, and the flag on the
                   product is where that judgement is recorded. *@
                <ul class="ei-ft-list">
                    @foreach (var product in ProductCatalog.All.Where(p => p.IsFeatured).Take(5))
                    {
                        <li><a asp-controller="Products" asp-action="Detail" asp-route-slug="@product.Slug">@product.Name</a></li>
                    }
                    <li><a asp-controller="Products" asp-action="Index">All products</a></li>
                </ul>
            </div>

            <div class="ei-ft-col">
                <h2 class="ei-ft-heading">Legal &amp; Privacy</h2>
                <ul class="ei-ft-list">
                    <li><a asp-controller="Pages" asp-action="Stub" asp-route-slug="accessibility">Accessibility</a></li>
                    <li><a asp-controller="Pages" asp-action="Stub" asp-route-slug="cookies-policy">Cookies Policy</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    <li><a asp-controller="Pages" asp-action="Stub" asp-route-slug="terms-of-website-use">Terms of Website Use</a></li>
                </ul>
            </div>

            <div class="ei-ft-col">
                <h2 class="ei-ft-heading">Stay in touch</h2>

                <p class="ei-ft-hours">
                    <svg aria-hidden="true"><use href="#i-clock" /></svg>
                    @CompanyProfile.BusinessHours
                </p>

                @* Icon-only, so each one carries its own label. The visible
                   glyph is aria-hidden and the accessible name comes from the
                   link. *@
                <ul class="ei-ft-social">
                    <li><a href="@CompanyProfile.LinkedIn" target="_blank" rel="noopener" aria-label="@CompanyProfile.Name on LinkedIn"><svg aria-hidden="true"><use href="#i-linkedin" /></svg></a></li>
                    <li><a href="@CompanyProfile.Facebook" target="_blank" rel="noopener" aria-label="@CompanyProfile.Name on Facebook"><svg aria-hidden="true"><use href="#i-facebook" /></svg></a></li>
                    <li><a href="@CompanyProfile.Twitter" target="_blank" rel="noopener" aria-label="@CompanyProfile.Name on X"><svg aria-hidden="true"><use href="#i-twitter" /></svg></a></li>
                    <li><a href="@CompanyProfile.YouTube" target="_blank" rel="noopener" aria-label="@CompanyProfile.Name on YouTube"><svg aria-hidden="true"><use href="#i-youtube" /></svg></a></li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="ei-ft-base">
        <div class="ei-shell ei-ft-base-inner">
            <span>&copy; @DateTime.Now.Year @CompanyProfile.LegalName. All rights reserved.</span>
            @*  This slot held "ISO 9001:2015 Certified · ISPM-15 Registered".
                Neither is claimed anywhere on eliteind.in and neither could be
                verified, so it carries what the client does say. Put
                certifications back only against the certificates, and name
                the issuing body when you do.  *@
            <span class="ei-ft-standards">Export Packaging &middot; Any quantity, on time</span>
            @* An in-page jump, not a scripted scroll: it works with the script
               blocked, and honours the smooth-scroll setting theme.css already
               drops under prefers-reduced-motion. *@
            <a class="ei-ft-totop" href="#siteHeader">
                Back to top
                <span class="ei-ft-totop-icon" aria-hidden="true"><svg><use href="#i-arrow-up" /></svg></span>
            </a>
        </div>
    </div>
</footer>
