@using EliteIndustries.Services
@model EliteIndustries.Models.ContactMessage
@*
    Contact page.

    Rebuilt onto theme.css: no ViewData["Legacy"]. Styles are
    wwwroot/css/contact-page.css (.ei-ct-*). The only script is the unobtrusive
    validation partial, as before.

    THE FORM IS UNCHANGED
    ---------------------
    Same fields, same asp-for bindings, same POST to ContactController, same
    antiforgery token — only the markup around the fields and the classes
    changed. tools/export_static.py rewrites the FIRST <form> on this page to a
    form service for the static build, so no other form may come before it.

    COPY
    ----
    The old page promised replies "within one business day", "a delivered
    price", and said the works and sales desk "share one address" — while
    listing two. None of that is the client's. This version only states the
    contact details in CompanyProfile.
*@
@{
    ViewData["Title"] = "Contact Us";
    ViewData["ActiveNav"] = "contact";
    ViewData["SeoTitle"] = $"Contact {CompanyProfile.Name} | Leading Provider of {CompanyProfile.ProductCategory} in {CompanyProfile.ShortAddress}";
    ViewData["Description"] = $"Contact {CompanyProfile.Name} — {CompanyProfile.StreetAddress}, {CompanyProfile.City}. Call {CompanyProfile.PhonePrimary} or send an enquiry for export packaging and material handling supply. {CompanyProfile.BusinessHours}.";

    // Keyless Google Maps embed and a directions link, both from CompanyProfile.
    var mapSrc = $"https://maps.google.com/maps?q={CompanyProfile.Latitude},{CompanyProfile.Longitude}&z=15&output=embed";
    var directions = $"https://www.google.com/maps/dir/?api=1&destination={CompanyProfile.Latitude},{CompanyProfile.Longitude}";

    var successMessage = TempData["ContactSuccess"] as string;
}

@section Head {
    <link rel="stylesheet" href="~/css/contact-page.css" asp-append-version="true" />
}

@* ================================ Hero ================================ *@
<section class="ei-ct-hero" aria-labelledby="ei-ct-title">
    <div class="ei-shell">
        <ol class="ei-ct-crumbs">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li aria-current="page">Contact Us</li>
        </ol>

        <p class="ei-ct-eyebrow">Contact us</p>
        <h1 class="ei-ct-title" id="ei-ct-title">Let's talk <span>packaging.</span></h1>
        <p class="ei-ct-lede">
            Tell us what you are shipping, how much of it and when it has to leave — any quantity,
            urgent or large.
        </p>

        @* Three quick routes. Each is a real link, so they work on a phone
           as a one-tap call, a mail draft and a map. *@
        <ul class="ei-ct-quick">
            <li>
                <a class="ei-ct-quick-card" href="tel:@CompanyProfile.PhonePrimaryHref">
                    <span class="ei-ct-quick-icon" aria-hidden="true"><svg><use href="#i-phone" /></svg></span>
                    <span class="ei-ct-quick-text">
                        <small>@CompanyProfile.PhoneLabel</small>
                        <strong>@CompanyProfile.PhonePrimary</strong>
                    </span>
                    <svg class="ei-ct-quick-arrow" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
            </li>
            <li>
                <a class="ei-ct-quick-card" href="mailto:@CompanyProfile.Email">
                    <span class="ei-ct-quick-icon" aria-hidden="true"><svg><use href="#i-mail" /></svg></span>
                    <span class="ei-ct-quick-text">
                        <small>Email the sales desk</small>
                        <strong>@CompanyProfile.Email</strong>
                    </span>
                    <svg class="ei-ct-quick-arrow" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
            </li>
            <li>
                <a class="ei-ct-quick-card" href="#find-us">
                    <span class="ei-ct-quick-icon" aria-hidden="true"><svg><use href="#i-pin" /></svg></span>
                    <span class="ei-ct-quick-text">
                        <small>Visit the works</small>
                        <strong>@CompanyProfile.ShortAddress</strong>
                    </span>
                    <svg class="ei-ct-quick-arrow" aria-hidden="true"><use href="#i-arrow-right" /></svg>
                </a>
            </li>
        </ul>
    </div>
</section>

@* ========================= Form + details ========================= *@
<section class="ei-band ei-band--shell ei-ct-main">
    <div class="ei-shell ei-ct-grid">

        <div class="ei-ct-form-card ei-reveal ei-reveal--left" id="enquiry">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="ei-ct-success" role="status">
                    <span class="ei-ct-success-icon" aria-hidden="true"><svg><use href="#i-shield" /></svg></span>
                    <p>@successMessage</p>
                </div>
            }

            <div class="ei-ct-form-head">
                <p class="ei-eyebrow">Send an enquiry</p>
                <h2>Tell us what you need</h2>
                <p>
                    Name, email and your requirement are all we need to start. The more you tell us
                    about size and quantity, the closer the first quote will be.
                </p>
            </div>

            <form class="ei-ct-form" asp-controller="Contact" asp-action="Index" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="ei-ct-summary"></div>

                <div class="ei-ct-fields">
                    <div class="ei-ct-field ei-ct-field--req">
                        <label asp-for="Name"></label>
                        <div class="ei-ct-control">
                            <svg aria-hidden="true"><use href="#i-users" /></svg>
                            <input asp-for="Name" autocomplete="name" placeholder="Your name" />
                        </div>
                        <span asp-validation-for="Name" class="ei-ct-error"></span>
                    </div>

                    <div class="ei-ct-field ei-ct-field--req">
                        <label asp-for="Email"></label>
                        <div class="ei-ct-control">
                            <svg aria-hidden="true"><use href="#i-mail" /></svg>
                            <input asp-for="Email" type="email" autocomplete="email" placeholder="name@company.com" />
                        </div>
                        <span asp-validation-for="Email" class="ei-ct-error"></span>
                    </div>

                    <div class="ei-ct-field">
                        <label asp-for="Company"></label>
                        <div class="ei-ct-control">
                            <svg aria-hidden="true"><use href="#i-works" /></svg>
                            <input asp-for="Company" autocomplete="organization" placeholder="Company name" />
                        </div>
                        <span asp-validation-for="Company" class="ei-ct-error"></span>
                    </div>

                    <div class="ei-ct-field">
                        <label asp-for="Phone"></label>
                        <div class="ei-ct-control">
                            <svg aria-hidden="true"><use href="#i-phone" /></svg>
                            <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="+91 00000 00000" />
                        </div>
                        <span asp-validation-for="Phone" class="ei-ct-error"></span>
                    </div>

                    <div class="ei-ct-field ei-ct-field--full">
                        <label asp-for="ProductInterest"></label>
                        <div class="ei-ct-control ei-ct-control--select">
                            <svg aria-hidden="true"><use href="#i-crate" /></svg>
                            <select asp-for="ProductInterest">
                                <option value="">Any / general enquiry</option>
                                @foreach (var product in ProductCatalog.All)
                                {
                                    <option value="@product.Name">@product.Name</option>
                                }
                            </select>
                            <svg class="ei-ct-select-caret" aria-hidden="true"><use href="#i-chevron-down" /></svg>
                        </div>
                        <span asp-validation-for="ProductInterest" class="ei-ct-error"></span>
                    </div>

                    <div class="ei-ct-field ei-ct-field--full ei-ct-field--req">
                        <label asp-for="Body"></label>
                        <div class="ei-ct-control ei-ct-control--area">
                            <textarea asp-for="Body" rows="6"
                                      placeholder="Product, size, quantity, destination and when it has to leave."></textarea>
                        </div>
                        <span asp-validation-for="Body" class="ei-ct-error"></span>
                    </div>
                </div>

                <div class="ei-ct-submit-row">
                    <p class="ei-ct-note"><span aria-hidden="true">*</span> Required</p>
                    <button type="submit" class="ei-ct-submit">
                        Send enquiry
                        <span class="ei-ct-submit-icon" aria-hidden="true"><svg><use href="#i-arrow-right" /></svg></span>
                    </button>
                </div>
            </form>
        </div>

        <aside class="ei-ct-details ei-reveal ei-reveal--right" style="--d:120ms" aria-labelledby="ei-ct-details-title">
            <h2 class="ei-ct-details-title" id="ei-ct-details-title">Reach us directly</h2>

            <ul class="ei-ct-list">
                <li>
                    <span class="ei-ct-disc" aria-hidden="true"><svg><use href="#i-pin" /></svg></span>
                    <div>
                        <h3>Works</h3>
                        <p>
                            @CompanyProfile.StreetAddress<br />
                            @CompanyProfile.City, @CompanyProfile.Region @CompanyProfile.PostalCode, @CompanyProfile.Country
                        </p>
                    </div>
                </li>
                <li>
                    <span class="ei-ct-disc" aria-hidden="true"><svg><use href="#i-works" /></svg></span>
                    <div>
                        <h3>@CompanyProfile.OfficeLabel</h3>
                        <p>
                            @CompanyProfile.OfficeStreetAddress<br />
                            @CompanyProfile.OfficeCity, @CompanyProfile.OfficeRegion
                        </p>
                    </div>
                </li>
                <li>
                    <span class="ei-ct-disc" aria-hidden="true"><svg><use href="#i-phone" /></svg></span>
                    <div>
                        <h3>Telephone</h3>
                        <p>
                            <a href="tel:@CompanyProfile.PhonePrimaryHref">@CompanyProfile.PhonePrimary</a><br />
                            <a href="tel:@CompanyProfile.PhoneSecondaryHref">@CompanyProfile.PhoneSecondary</a>
                        </p>
                    </div>
                </li>
                <li>
                    <span class="ei-ct-disc" aria-hidden="true"><svg><use href="#i-mail" /></svg></span>
                    <div>
                        <h3>Email</h3>
                        <p><a href="mailto:@CompanyProfile.Email">@CompanyProfile.Email</a></p>
                    </div>
                </li>
                <li>
                    <span class="ei-ct-disc" aria-hidden="true"><svg><use href="#i-clock" /></svg></span>
                    <div>
                        <h3>Business hours</h3>
                        <p>@CompanyProfile.BusinessHours</p>
                    </div>
                </li>
            </ul>

            <a class="ei-ct-brochure" href="@CompanyProfile.BrochurePath" download>
                <span class="ei-ct-brochure-icon" aria-hidden="true"><svg><use href="#i-download" /></svg></span>
                <span>
                    <strong>Download our brochure</strong>
                    <small>The full product range, PDF</small>
                </span>
            </a>
        </aside>
    </div>
</section>

@* ================================ Map ================================ *@
<section class="ei-band ei-ct-map-band" id="find-us" aria-labelledby="ei-ct-map-title">
    <div class="ei-shell">
        <div class="ei-ct-map ei-reveal">
            <iframe src="@mapSrc"
                    title="Map showing @CompanyProfile.Name at @CompanyProfile.FullAddress"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen></iframe>

            <div class="ei-ct-map-card">
                <p class="ei-ct-map-eyebrow">Find us</p>
                <h2 id="ei-ct-map-title">@CompanyProfile.City works</h2>
                <p>@CompanyProfile.FullAddress</p>
                <a class="ei-ct-map-btn" href="@directions" target="_blank" rel="noopener">
                    <svg aria-hidden="true"><use href="#i-truck" /></svg>
                    Get directions
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
